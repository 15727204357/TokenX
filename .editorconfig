root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml,yml,yaml,json,ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.md]
# Markdown hard line breaks are expressed with two trailing spaces.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{sh,mvnw}]
end_of_line = lf

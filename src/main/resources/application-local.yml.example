# Example of the local override file. Copy to `application-local.yml` (same directory) and set your
# own local values. `application-local.yml` is git-ignored; this example is not.
#
# Keep only local credentials here: the JDBC URL and username are declared in application.yml (dev)
# and application-test.yml (tests), so this file must not override them.
#
# The application account is a dedicated local user (never root) that owns only the `tokenx` and
# `tokenx_test` databases. See README "本地数据库准备".
spring:
  datasource:
    password: "<your-local-password>"

tokenx:
  auth:
    jwt:
      # Signing key for issued tokens. At least 32 characters. Generate one, never reuse a public
      # value:  openssl rand -base64 48
      # Alternatively export TOKENX_JWT_SECRET and leave this line out.
      secret: "<your-local-jwt-secret-at-least-32-chars>"
